{
  "name": "openbot-wow",
  "version": "0.1.0",
  "description": "Bridge between the OpenBot addon for World of Warcraft: Forever and OpenBot on this computer. Early, experimental.",
  "author": "Ryan Hughes (T3 Code for WoW), OpenBot port",
  "type": "module",
  "private": true,
  "bin": {
    "openbot-wow": "bin/openbot-wow.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/openbot-wow.js run",
    "build:team": "node team/build.mjs"
  },
  "license": "MIT",
  "optionalDependencies": {
    "node-datachannel": "0.33.6"
  },
  "devDependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "effect": "4.0.6",
    "emoji-regex": "10.6.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "marked": "18.1.1",
    "ts-log": "3.0.3"
  }
}
